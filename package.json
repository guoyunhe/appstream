{
  "name": "appstream",
  "version": "1.1.0",
  "description": "A fast and lightweight JavaScript/TypeScript parser and generator for Freedesktop.org AppStream XML metadata",
  "keywords": [
    "appdata",
    "appstream",
    "freedesktop",
    "linux",
    "metainfo",
    "parser",
    "software-center",
    "xml"
  ],
  "homepage": "https://github.com/guoyunhe/appstream#readme",
  "bugs": {
    "url": "https://github.com/guoyunhe/appstream/issues"
  },
  "license": "AGPL-3.0-only",
  "author": "Guo Yunhe <i@guoyunhe.me> (https://guoyunhe.me)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guoyunhe/appstream.git"
  },
  "files": [
    "CHANGELOG.md",
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "prepare": "husky",
    "prepublishOnly": "pnpm run build",
    "release": "bumpp",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.1"
  },
  "devDependencies": {
    "@guoyunhe/oxfmt-config": "^1.1.0",
    "@types/node": "^26.1.1",
    "bumpp": "^11.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "oxfmt": "^0.67.0",
    "tsdown": "^0.22.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts,jsx,tsx,vue,json,jsonc,css,scss,less,htm,html,md,mdx,yaml,yml}": "oxfmt --write"
  }
}
